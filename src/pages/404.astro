---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="This page is not part of Astro.">
  <section class="page-head shell not-found">
    <p class="eyebrow">404</p>
    <h1>Nothing at this address.</h1>
    <p class="lede measure">The page you asked for is not part of Astro.</p>
    <p><a class="button" href="/">Back to the start</a></p>
  </section>
</Base>

<style>
  .not-found {
    padding-bottom: var(--space-6);
  }
</style>
