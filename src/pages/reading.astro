---
import Base from '../layouts/Base.astro';
---
<Base title="Reading" description="Astro's reading page. No chart is shown until the calculation behind it is real.">
  <section class="page-head shell">
    <p class="eyebrow">Reading</p>
    <h1>No chart has been drawn yet.</h1>
    <p class="lede measure">
      This page will hold your reading. Astro shows a chart only when the calculation behind it is real: a named astronomical ephemeris, the time zone in force at your birth, and a house system stated plainly. None of that exists in this version, so nothing is shown here, and nothing is invented.
    </p>
  </section>

  <section class="shell section section--last">
    <div class="sheet flow reading-sheet">
      <h2 class="h3">What will appear here</h2>
      <dl class="spec">
        <div class="spec__row">
          <dt>Positions</dt>
          <dd>The Sun, Moon and planets, to the degree and minute of the ecliptic.</dd>
        </div>
        <div class="spec__row">
          <dt>Houses</dt>
          <dd>Twelve houses, with the house system named. Absent when the time of birth is unknown.</dd>
        </div>
        <div class="spec__row">
          <dt>Aspects</dt>
          <dd>The angles between bodies, listed rather than implied.</dd>
        </div>
        <div class="spec__row">
          <dt>Method</dt>
          <dd>The ephemeris and its version, the time zone used and the house system, printed beneath every chart.</dd>
        </div>
      </dl>
      <div class="actions">
        <a class="button button--quiet" href="/chart">Back to the chart form</a>
        <a class="link-arrow" href="/learn">How charts are made</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .reading-sheet {
    --flow: var(--space-3);
    max-width: 44rem;
  }

  .spec {
    display: grid;
    gap: var(--space-2);
  }

  .spec__row {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-2);
    border-top: 2px solid var(--rule);
  }

  @media (min-width: 40rem) {
    .spec__row {
      grid-template-columns: 9rem 1fr;
      gap: var(--space-3);
    }
  }

  .spec dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--ink);
  }

  .spec dd {
    margin: 0;
  }
</style>
