---
import Base from '../layouts/Base.astro';
---
<Base title="Reading" description="A natal chart calculated in the browser with astronomy-engine. Studio access for Atlas Interactive.">
  <section class="page-head shell reading-mount" data-reading>
    <p class="eyebrow">Reading</p>
    <h1>The chart is drawn in this browser.</h1>
    <p class="lede measure">
      Enable JavaScript to calculate with astronomy-engine. Studio sign-in is required. Birth facts stay in this browser and are not written into the address bar.
    </p>
    <p><a class="button button--quiet" href="/chart">Back to the chart form</a></p>
  </section>
</Base>

<script>
  import { mountReading } from '../lib/chart/reading-client';

  const root = document.querySelector<HTMLElement>('[data-reading]');
  if (root) void mountReading(root);
</script>

<style is:global>
  .reading-grid {
    display: grid;
    gap: var(--space-4);
    align-items: start;
    margin-top: var(--space-4);
  }

  @media (min-width: 56rem) {
    .reading-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }

  .reading-data {
    --flow: var(--space-3);
  }

  .method-line {
    margin-top: var(--space-4);
    max-width: 50rem;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-deep);
  }

  .planet-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step-0);
  }

  .planet-table th,
  .planet-table td {
    padding: 0.45rem 0;
    text-align: left;
    border-top: 2px solid var(--rule);
    vertical-align: baseline;
  }

  .planet-table thead th {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    border-top: 0;
  }

  .planet-table tbody th {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
  }

  .wheel-wrap {
    max-width: 28rem;
    margin-inline: auto;
  }

  .chart-wheel {
    width: 100%;
    height: auto;
    display: block;
  }

  .wheel-fill {
    fill: var(--paper);
  }

  .wheel-core {
    fill: var(--band);
  }

  .wheel-ring,
  .wheel-sign-ray {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }

  .wheel-house-ray {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1.5;
  }

  .wheel-sign {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    fill: var(--ink);
  }

  .wheel-house {
    font-family: var(--font-text);
    font-size: 11px;
    font-weight: 600;
    fill: var(--ink-deep);
  }

  .wheel-planet {
    fill: var(--accent-deep);
  }

  .wheel-planet-name {
    font-family: var(--font-text);
    font-size: 10px;
    font-weight: 600;
    fill: var(--ink-deep);
  }

  .reading-meta {
    display: grid;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-3) 0;
    padding: var(--space-3);
    background: var(--paper);
    border: 2px solid var(--ink);
    max-width: 42rem;
  }

  @media (min-width: 40rem) {
    .reading-meta {
      grid-template-columns: 1fr 1fr;
    }
  }

  .reading-meta dt {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
  }

  .reading-meta dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-text);
    color: var(--ink-deep);
  }

  .empty-state {
    margin-top: var(--space-3);
    padding: var(--space-4);
    background: var(--paper);
    border: 2px solid var(--ink);
    max-width: 42rem;
  }

  .empty-state-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin: 0 0 var(--space-2);
    color: var(--ink);
  }

  .empty-state-hint {
    margin: 0 0 var(--space-3);
    color: var(--ink-deep);
  }

  .recall {
    margin-top: var(--space-4);
    max-width: 42rem;
  }

  .recall ul {
    margin: var(--space-2) 0 0;
    padding-left: 1.2rem;
  }
</style>
