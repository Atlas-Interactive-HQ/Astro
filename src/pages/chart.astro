---
import Base from '../layouts/Base.astro';
import ChartForm from '../components/ChartForm.astro';
---
<Base title="Chart" description="Enter a date, time and place of birth. The natal chart is calculated in this browser with Swiss Ephemeris.">
  <section class="page-head shell">
    <p class="eyebrow">Chart</p>
    <h1>Begin a chart</h1>
    <p class="lede measure">
      Three facts fix a sky: the day, the hour and the place. The more exact the hour, the more exact the houses.
    </p>
  </section>

  <section class="shell chart-layout section section--last">
    <ChartForm />
    <aside class="chart-aside flow" aria-labelledby="next-title">
      <h2 id="next-title" class="h3">What happens next</h2>
      <p>
        The place is resolved to coordinates (Nominatim, if you use the list) and to the IANA time zone in force on that date. Swiss Ephemeris then calculates the chart in this browser. Nothing is posted to Atlas for the calculation.
      </p>
      <p>
        Without a time of birth, planets are placed at local noon. Houses and the rising sign stay blank.
      </p>
    </aside>
  </section>
</Base>

<style>
  .chart-layout {
    display: grid;
    gap: var(--space-4) var(--space-5);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .chart-layout {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }

  .chart-aside {
    max-width: 30rem;
    padding-top: var(--space-2);
  }
</style>
