---
import { NAV } from '../lib/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---
<header class="site-header on-ground">
  <div class="shell site-header__inner">
    <a class="wordmark" href="/" aria-label="Astro, home">Astro</a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {NAV.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="studio-slot" data-studio hidden></div>
  </div>
</header>

<script>
  import { mountStudioSlot } from '../lib/auth/header-client';

  const slot = document.querySelector<HTMLElement>('[data-studio]');
  if (slot) mountStudioSlot(slot);
</script>

<style>
  .site-header {
    padding-block: var(--space-3);
    background-color: var(--ground);
    background-image: var(--grain);
    background-repeat: repeat;
    background-blend-mode: multiply;
    color: var(--on-ground);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    letter-spacing: -0.01em;
    color: var(--on-ground);
    text-decoration: none;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .site-nav a {
    display: inline-block;
    padding-block: 0.25rem;
    font-weight: 500;
    color: var(--on-ground);
    text-decoration: none;
    /* Ground, not transparent: the bundler emits #0000 for transparent. */
    border-bottom: 2px solid var(--ground);
  }

  .site-nav a:hover {
    border-bottom-color: var(--on-ground);
  }

  .site-nav a[aria-current='page'] {
    font-weight: 600;
    border-bottom-color: var(--band);
  }

  .studio-slot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--step--1);
  }

  .studio-who {
    color: var(--on-ground);
  }

  .studio-link {
    font-weight: 500;
  }

  .studio-out {
    min-height: 2.25rem;
    padding: 0.35em 0.9em;
    border: 2px solid var(--ink-deep);
    border-radius: var(--radius-round);
    background-color: var(--paper);
    color: var(--ink-deep);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 36rem) {
    .site-header__inner {
      justify-content: center;
      text-align: center;
    }
  }
</style>
