---
/*
  Chart input. Birth facts stay in this browser (sessionStorage) and are
  never given `name` attributes, so a non-JS submit still sends nothing.
  Place lookup uses Nominatim (network, coordinates only). The natal
  calculation runs in this browser on /reading (astronomy-engine).
*/
---
<form class="chart-form sheet" action="/reading" method="get" aria-labelledby="chart-form-title">
  <h2 id="chart-form-title" class="h3 chart-form__title">Three facts</h2>

  <div class="field">
    <label class="field__label" for="birth-date">Date of birth</label>
    <p class="field__help" id="birth-date-help">Day, month and year.</p>
    <input class="input" id="birth-date" type="date" required autocomplete="bday" aria-describedby="birth-date-help" />
  </div>

  <fieldset class="field">
    <legend class="field__label">Time of birth</legend>
    <p class="field__help" id="birth-time-help">
      As exact as you have it. Without a time, Astro places the planets at local noon and does not draw houses or the rising sign.
    </p>
    <label class="visually-hidden" for="birth-time">Hour and minute</label>
    <input
      class="input"
      id="birth-time"
      type="time"
      step="60"
      autocomplete="off"
      aria-describedby="birth-time-help"
      data-birth-time
    />
    <label class="check" for="time-unknown">
      <input id="time-unknown" type="checkbox" data-time-unknown />
      <span>I don't know my time of birth</span>
    </label>
  </fieldset>

  <div class="field">
    <label class="field__label" for="birth-place">Place of birth</label>
    <p class="field__help" id="birth-place-help">
      Town or city, and country. Choosing a suggestion looks the place up through OpenStreetMap Nominatim — a network request for coordinates only. The chart is calculated in this browser afterwards, and is not sent to us.
    </p>
    <input
      class="input"
      id="birth-place"
      type="text"
      required
      autocomplete="off"
      spellcheck="false"
      aria-describedby="birth-place-help"
      aria-autocomplete="list"
      aria-controls="place-suggest"
    />
    <ul id="place-suggest" class="suggest" data-place-suggest hidden></ul>
  </div>

  <fieldset class="field coords">
    <legend class="field__label">Coordinates</legend>
    <p class="field__help" id="coords-help">Filled when you pick a place. You may enter them yourself instead of using Nominatim.</p>
    <div class="coords__pair">
      <label class="field__label" for="birth-lat">Latitude</label>
      <input class="input" id="birth-lat" type="number" step="0.0001" min="-90" max="90" inputmode="decimal" aria-describedby="coords-help" />
    </div>
    <div class="coords__pair">
      <label class="field__label" for="birth-lon">Longitude</label>
      <input class="input" id="birth-lon" type="number" step="0.0001" min="-180" max="180" inputmode="decimal" aria-describedby="coords-help" />
    </div>
  </fieldset>

  <div class="chart-form__actions">
    <button class="button" type="submit">Continue to the reading</button>
    <p class="note" data-form-status>
      The natal calculation runs in this browser with astronomy-engine. Place lookup is a Nominatim network call for coordinates only. Birth facts are not sent to Google.
    </p>
  </div>
</form>

<script>
  import { bindChartForm } from '../lib/chart/form-client';

  const form = document.querySelector<HTMLFormElement>('form.chart-form');
  if (form) bindChartForm(form);
</script>

<style>
  .chart-form {
    display: grid;
    gap: var(--space-4);
  }

  .chart-form__title {
    color: var(--ink);
  }

  .chart-form__actions {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding-top: var(--space-1);
  }

  .suggest {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background-color: var(--paper);
    max-height: 12rem;
    overflow: auto;
  }

  .suggest button {
    display: block;
    width: 100%;
    padding: 0.6rem 1rem;
    border: 0;
    background-color: var(--paper);
    color: var(--ink-deep);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .suggest button:hover,
  .suggest button:focus-visible {
    background-color: var(--field);
  }

  .coords {
    display: grid;
    gap: var(--space-2);
  }

  .coords__pair {
    display: grid;
    gap: var(--space-1);
  }

  @media (min-width: 36rem) {
    .coords {
      grid-template-columns: 1fr 1fr;
    }

    .coords legend,
    .coords .field__help {
      grid-column: 1 / -1;
    }
  }
</style>
